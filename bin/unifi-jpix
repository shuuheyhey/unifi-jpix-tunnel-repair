#!/bin/sh
set -eu
# The boot installer exposes this launcher through /usr/local/bin and current.
# Resolve both symlinks before locating the release's Python package.
SELF=$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().parent)' "$0")
if [ -d "$SELF/../src/unifi_jpix" ]; then
  PYTHONPATH=$SELF/../src${PYTHONPATH:+:$PYTHONPATH}
elif [ -d "$SELF/../lib/unifi_jpix" ]; then
  PYTHONPATH=$SELF/../lib${PYTHONPATH:+:$PYTHONPATH}
else
  printf '%s\n' 'unifi-jpix Python package is unavailable' >&2
  exit 1
fi
export PYTHONPATH
PYTHONDONTWRITEBYTECODE=1
export PYTHONDONTWRITEBYTECODE
exec python3 -m unifi_jpix.cli "$@"
