  "iid": "00cb:0071:2a00:0000",
  "endpoint_network": {
    "ipv4_cidr": "192.168.20.0/24"
  },
  "routed_networks": [
    {
      "interface": "br0",
      "ipv4_cidr": "192.168.20.0/24"
    }
  ],
