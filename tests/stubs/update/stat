#!/bin/sh
set -eu
[ -z "${CHILD_ENV_LOG:-}" ] || { printf '%s\n' '--- stat ---' >>"$CHILD_ENV_LOG"; env >>"$CHILD_ENV_LOG"; }
if [ "${STUB_STAT_FOREIGN_CONFIG_DIR:-0}" = 1 ] && [ "$#" -eq 3 ] && [ "$1 $2" = '-c %u' ] && [ "$3" = "$CONFIG" ]; then
  printf '%s\n' 1234
  exit 0
fi
if [ "${STUB_STAT_FOREIGN_STATE:-0}" = 1 ] && [ "$#" -eq 3 ] && [ "$1 $2" = '-c %u' ] && [ "$3" = "$STATE/last-provider-update.state" ]; then
  printf '%s\n' 1234
  exit 0
fi
if command -v gstat >/dev/null 2>&1; then
  exec gstat "$@"
fi
exec /usr/bin/stat "$@"
