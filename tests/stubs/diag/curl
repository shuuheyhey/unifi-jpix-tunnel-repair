#!/bin/sh
set -eu

{
  printf 'curl'
  for arg do printf ' %s' "$arg"; done
  printf '\n'
} >>"$STUB_LOG"

case " $* " in
  *' -4 '*) [ "${DIAG_CURL4_FAIL:-0}" != 1 ] || exit 22 ;;
  *' -6 '*) [ "${DIAG_CURL6_FAIL:-0}" != 1 ] || exit 22 ;;
  *) exit 98 ;;
esac
printf 'response-body-MUST-NOT-LEAK user=body-user&pass=body-secret\n'
