#!/bin/sh
printf 'iptables %s\n' "$*" >>"$STUB_LOG"
case ${PREFLIGHT_STUB_MODE:-ready}:$* in
  nft-backend:'--version') printf 'iptables v1.8.7 (nf_tables)\n' ;;
  *:'--version') printf 'iptables v1.8.7 (legacy)\n' ;;
  missing-parent:'-t nat -S UBIOS_POSTROUTING_JUMP') exit 1 ;;
  detached-parent:'-t nat -S UBIOS_POSTROUTING_JUMP') printf '%s\n' '-A UBIOS_POSTROUTING_JUMP -j SOME_OTHER_CHAIN' ;;
  duplicate-parent:'-t nat -S UBIOS_POSTROUTING_JUMP') printf '%s\n%s\n' '-A UBIOS_POSTROUTING_JUMP -j UBIOS_POSTROUTING_USER_HOOK' '-A UBIOS_POSTROUTING_JUMP -j UBIOS_POSTROUTING_USER_HOOK' ;;
  *:'-t nat -S UBIOS_POSTROUTING_JUMP') printf '%s\n' '-A UBIOS_POSTROUTING_JUMP -j UBIOS_POSTROUTING_USER_HOOK' ;;
  *:'-t nat -S UBIOS_POSTROUTING_USER_HOOK')
    printf '%s\n' '-N UBIOS_POSTROUTING_USER_HOOK'
    ;;
  *) exit 1 ;;
esac
