#!/bin/sh
printf 'ip %s\n' "$*" >>"$STUB_LOG"

case ${PREFLIGHT_STUB_MODE:-ready}:$* in
  unsupported-iproute:'-Version') printf 'ip utility, iproute2-99.0.0\n' ;;
  *:'-Version') printf 'ip utility, iproute2-5.9.0, libbpf 0.3.0\n' ;;
  missing-ipv6:*) exit 0 ;;
  expanded-pd:'-6 route show table all proto dhcp')
    ;;
  expanded-pd:'-6 route show table all proto ra')
    printf 'default via fe80::1 dev eth9 proto ra metric 1024\n'
    ;;
  expanded-pd:'-6 route show table all proto kernel')
    printf '2001:db8:1234:100::/64 dev br-secret proto kernel metric 256\n'
    ;;
  expanded-pd:'-d link show type bridge')
    printf '10: br-secret: <BROADCAST,MULTICAST,UP> mtu 1500 state UP\n'
    printf '    link/ether aa:bb:cc:dd:ee:ff brd ff:ff:ff:ff:ff:ff\n'
    printf '    bridge forward_delay 1500 hello_time 200 max_age 2000\n'
    ;;
  wan-only-64:'-6 route show table all proto dhcp')
    ;;
  wan-only-64:'-6 route show table all proto ra')
    printf 'default via fe80::1 dev eth9 proto ra metric 1024\n'
    ;;
  wan-only-64:'-6 route show table all proto kernel')
    printf '2001:db8:1234:30::/64 dev eth9 proto kernel metric 256\n'
    ;;
  wan-only-64:'-d link show type bridge')
    ;;
  *:'-6 route show default')
    printf 'default via fe80::1 dev eth9 proto ra metric 1024\n'
    ;;
  *:'-6 addr show scope global')
    printf '9: eth9: <UP> mtu 1500\n    inet6 2001:db8:1234:30::1/64 scope global dynamic\n       valid_lft 3600sec preferred_lft 1800sec\n    link/ether aa:bb:cc:dd:ee:ff\n'
    ;;
  *:'-6 route show table all proto dhcp')
    printf '2001:db8:1234:100::/56 dev br0 proto dhcp metric 1024\n'
    ;;
  *:'-6 route show table all proto ra')
    printf 'default via fe80::1 dev eth9 proto ra metric 1024\n'
    ;;
  *:'-d -6 tunnel show')
    printf 'ip6tnl0: any/ipv6 remote any local any encaplimit 4 hoplimit 64 tclass 0x00 flowlabel 0x00000 (flowinfo 0x00000000)\n'
    printf 'ip6tnl-secret: ip/ipv6 remote 2001:db8:ffff::1 local 2001:db8:1234:30::1 encaplimit 4 hoplimit 64 tclass 0x00 flowlabel 0x00000 (flowinfo 0x00000000)\n'
    ;;
  *) exit 1 ;;
esac
