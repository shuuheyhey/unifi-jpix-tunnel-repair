[Unit]
Description=Apply JPIX v6plus fixed IPv4 tunnel state
After=network-online.target
Wants=network-online.target
ConditionPathExists=/data/v6plus/config/v6plus.env
ConditionPathExists=/data/v6plus/config/networks.conf
ConditionPathExists=/data/v6plus/config/update.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ReadOnlyPaths=/data/v6plus/scripts /data/v6plus/config
ExecStartPre=/data/v6plus/scripts/v6plus-wait-wan.sh --timeout 300
ExecStart=/data/v6plus/scripts/v6plus-apply.sh apply
ExecStartPost=-/data/v6plus/scripts/v6plus-update.sh --force
RemainAfterExit=yes
TimeoutStartSec=480
