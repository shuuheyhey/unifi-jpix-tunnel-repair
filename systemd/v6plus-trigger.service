[Unit]
Description=Monitor UniFi netlink changes for JPIX v6plus fixed IPv4
Requires=v6plus-apply.service
After=v6plus-apply.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ReadOnlyPaths=/data/v6plus/scripts /data/v6plus/config
ExecStart=/data/v6plus/scripts/v6plus-trigger.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
