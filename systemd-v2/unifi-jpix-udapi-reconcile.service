[Unit]
Description=Reconcile JPIX after the asynchronous UniFi firewall rebuild
After=network-online.target
ConditionPathExists=/data/unifi-jpix-tunnel-repair/config-v2.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ReadOnlyPaths=/data/unifi-jpix-tunnel-repair/current /data/unifi-jpix-tunnel-repair/config-v2.json -/data/unifi-jpix-tunnel-repair/credentials-v2.json
ExecStartPre=/bin/sleep 10
ExecStart=/data/unifi-jpix-tunnel-repair/current/bin/unifi-jpix reconcile --retry
TimeoutStartSec=210
